{
  "manifest_version": 3,
  "name": "AccessCheck",
  "version": "0.9.0",
  "description": "Inspect accessibility problems in the current tab: what failed, where it is, and the real keyboard focus path.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab", "scripting", "sidePanel", "storage", "debugger"],
  "action": {
    "default_title": "Audit this page with AccessCheck",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" }
}

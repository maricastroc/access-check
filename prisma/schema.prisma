generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model SiteScan {
  id String @id @default(cuid())

  rootUrl String
  status  String @default("running")
  locale  String @default("en")

  totalPages   Int @default(0)
  scannedPages Int @default(0)
  failedPages  Int @default(0)

  score Int?
  error String?

  pages SiteScanPage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("site_scans")
}

model SiteScanPage {
  id         String   @id @default(cuid())
  siteScanId String
  siteScan   SiteScan @relation(fields: [siteScanId], references: [id], onDelete: Cascade)

  url    String
  status String @default("pending")

  title String?
  score Int?

  critical Int @default(0)
  serious  Int @default(0)
  moderate Int @default(0)
  minor    Int @default(0)

  result Json?

  error String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([siteScanId])
  @@map("site_scan_pages")
}
